#!/usr/bin/env bash
# act-cell — thin wrapper around `act` for running individual ci.yml cells
# locally. See AGENTS.md §3.6 for context.
#
# Usage: tools/act-cell <cell> [--push-devel] [extra act args...]
#   <cell>  cell id from ci.yml (1a, 1b, 1c, 1d, 6, 7, 8, 9, 12, 13, 14) OR
#           job alias (lint, valgrind, helgrind, chronos, nimony). Cells
#           2/3/4/5/18 were retired in push 9 (see audit §3) and now exit 2
#           with a pointer. Cell 1 was split into 1a/1b/1c/1d (per-MM
#           parallel matrix cells); passing bare `1` exits 2 with a pointer.
#
# Cells that cannot run via act locally exit 2 with a clear message:
#   10  Linux arm64 — runs-on: ubuntu-24.04-arm (no amd64 emulation path
#       worth the bother; just push and let GHA's arm64 runner do it).
#   11  macOS arm64 — Docker cannot host a macOS runner.
#   17  Windows MSVC — Docker cannot host a Windows runner.
#   14  nimony — works in principle but pulls ~30 min of build time
#       under qemu emulation; recommended to skip locally.
#
# --push-devel: synthesize an event payload that satisfies push-gated job
# `if:` clauses. Tier C jobs (test-heavy cells 6/7, valgrind 8, helgrind 9,
# plus runner-OS-specific cells 10/11/17) are gated by:
#   if: github.event_name == 'push'
#       && (github.ref == 'refs/heads/main' || github.ref == 'refs/heads/devel')
# act defaults to event_name=pull_request, so without this flag those jobs
# silently exit 0 without running. Use --push-devel when locally validating
# Tier C cells. Default behavior remains pull_request, matching local dev
# intent for Tier A.
set -euo pipefail

# Pre-pass: handle watchdog-related flags that may appear before the cell
# argument (or, in the case of --print-watchdog-config, alone). This runs
# before the "must have a cell arg" check below so that
# `tools/act-cell --print-watchdog-config` works as a config probe with no
# cell.
NO_WATCHDOG=0
PRINT_WATCHDOG_CONFIG=0
PREPASS_REMAINING=()
for arg in "$@"; do
  case "$arg" in
    --no-watchdog) NO_WATCHDOG=1 ;;
    --print-watchdog-config) PRINT_WATCHDOG_CONFIG=1 ;;
    *) PREPASS_REMAINING+=("$arg") ;;
  esac
done
set -- "${PREPASS_REMAINING[@]+"${PREPASS_REMAINING[@]}"}"

# Watchdog threshold resolution: 5-minute stall, 90-minute hard timeout
# (defaults), overridable via env vars for testing / operator tuning.
STALL_SECS="${LFQ_ACT_STALL_SECS:-300}"
HARD_TIMEOUT_SECS="${LFQ_ACT_HARD_TIMEOUT_SECS:-5400}"

if [[ "$PRINT_WATCHDOG_CONFIG" -eq 1 ]]; then
  echo "STALL_SECS=${STALL_SECS}"
  echo "HARD_TIMEOUT_SECS=${HARD_TIMEOUT_SECS}"
  exit 0
fi

if [[ $# -lt 1 ]]; then
  echo "usage: $0 <cell|alias> [extra act args...]" >&2
  echo "  Tier A (always-on):           1a 1b 1c 1d 13 (test-fast); 12 (chronos); 14 (nimony); L (lint)" >&2
  echo "  Tier C (main/devel push gate): 6 7 (test-heavy); 8 (valgrind); 9 (helgrind)" >&2
  echo "  Tier C (no local runner):     10 11 17" >&2
  echo "  aliases: lint valgrind helgrind chronos nimony" >&2
  exit 64
fi

CELL="$1"
shift

# Sift --push-devel (and any trailing watchdog flags) out of the trailing
# args before they pass through to act. Preserves order of remaining args
# (act's last-arg-wins behavior is intact).
PUSH_DEVEL=false
PASSTHROUGH_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --push-devel) PUSH_DEVEL=true ;;
    --no-watchdog) NO_WATCHDOG=1 ;;
    --print-watchdog-config) PRINT_WATCHDOG_CONFIG=1 ;;
    *) PASSTHROUGH_ARGS+=("$arg") ;;
  esac
done
set -- "${PASSTHROUGH_ARGS[@]+"${PASSTHROUGH_ARGS[@]}"}"

# Defensive LFQ_ACT_BIN resolution (B1+B2-b will land the canonical version;
# resolving here defensively keeps the watchdog test self-contained).
ACT_BIN="${LFQ_ACT_BIN:-act}"

# Resolve cell -> (job, matrix-flags). Job names come from ci.yml `jobs:`
# keys; matrix-flags from the `include:` entries in the `test` job. The
# `--matrix cell:<N>` selector pins a single matrix row.
JOB=""
MATRIX_ARGS=()
UNSUPPORTED_REASON=""

case "$CELL" in
  lint|L|l)
    JOB="lint"
    ;;
  valgrind|8)
    JOB="valgrind"
    ;;
  helgrind|9)
    JOB="helgrind"
    ;;
  chronos|12)
    JOB="chronos"
    ;;
  nimony|14)
    UNSUPPORTED_REASON="nimony cell builds nimony from source (~30 min uncached) and runs under amd64 emulation on Apple Silicon (3-5x slowdown). Run on GHA instead."
    ;;
  10)
    UNSUPPORTED_REASON="cell 10 runs on ubuntu-24.04-arm (native arm64 GHA runner); no useful local equivalent under act."
    ;;
  11)
    UNSUPPORTED_REASON="cell 11 is macOS arm64; Docker cannot host a macOS runner. Run natively: nimble test"
    ;;
  17)
    UNSUPPORTED_REASON="cell 17 is Windows MSVC; Docker cannot host a Windows runner. Wait for GHA."
    ;;
  1a|1b|1c|1d|13)
    # Tier A test-fast matrix (cells 1a/1b/1c/1d split baseline by MM
    # variant; cell 13 nim devel informational).
    JOB="test-fast"
    MATRIX_ARGS=(--matrix "cell:$CELL")
    ;;
  1)
    UNSUPPORTED_REASON="cell 1 was split into 1a (orc) / 1b (cpp) / 1c (arc+nebr) / 1d (refc) so MM lanes run as parallel GHA matrix cells. Choose one of 1a/1b/1c/1d."
    ;;
  6|7)
    # Tier C test-heavy matrix (cells 6 TSAN, 7 ASAN; cells 10/11/17 require
    # non-Linux/arm64 runners and are filtered above).
    JOB="test-heavy"
    MATRIX_ARGS=(--matrix "cell:$CELL")
    ;;
  2|3|4|5|18)
    UNSUPPORTED_REASON="cell $CELL was retired in push 9 (audit §3 green-mirage analysis). Cells 2/3/4/5 exported LOCKFREE_MM env var that no source consumed; cell 18 (nim cpp) is covered by cell 1's nimble test inner loop."
    ;;
  *)
    echo "act-cell: unknown cell or alias: $CELL" >&2
    echo "  Tier A: 1a 1b 1c 1d 13 lint chronos nimony 12 14 L" >&2
    echo "  Tier C: 6 7 8 9 valgrind helgrind" >&2
    exit 64
    ;;
esac

if [[ -n "$UNSUPPORTED_REASON" ]]; then
  echo "act-cell: cell '$CELL' cannot run via act locally." >&2
  echo "  reason: $UNSUPPORTED_REASON" >&2
  exit 2
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# Detect container architecture from the host. `.actrc` deliberately
# does not pin one (committed file, shared across arm64/amd64 hosts);
# act otherwise defaults `linux/amd64` regardless of host, which sends
# Apple Silicon down the qemu emulation path (3-5x slowdown). The
# multi-arch ghcr.io/elijahr/lockfree-ci:latest image supports both
# arches natively. If the user passes their own `--container-architecture`
# in "$@", act's last-arg-wins behavior makes their override win.
case "$(uname -m)" in
  arm64|aarch64) host_arch=linux/arm64 ;;
  x86_64|amd64)  host_arch=linux/amd64 ;;
  *) echo "act-cell: warning: unrecognized uname -m=$(uname -m); falling back to linux/amd64" >&2
     host_arch=linux/amd64 ;;
esac

# Build act invocation. When --push-devel was passed, synthesize a push
# event payload (ref=refs/heads/devel) so act schedules Tier C jobs whose
# `if:` clauses gate on push to main|devel. The payload is written to a
# temp file because `act --eventpath` requires a file path; the file is
# cleaned up on shell exit.
EVENT_ARGS=()
if [[ "$PUSH_DEVEL" == "true" ]]; then
  EVENT_PAYLOAD="$(mktemp -t act-cell-push-devel.XXXXXX)"
  trap 'rm -f "$EVENT_PAYLOAD"' EXIT
  cat > "$EVENT_PAYLOAD" <<'JSON'
{
  "ref": "refs/heads/devel",
  "before": "0000000000000000000000000000000000000000",
  "after": "0000000000000000000000000000000000000001",
  "repository": {
    "default_branch": "devel",
    "master_branch": "devel"
  }
}
JSON
  EVENT_ARGS=(push --eventpath "$EVENT_PAYLOAD")
fi

CMD=("$ACT_BIN" "${EVENT_ARGS[@]+"${EVENT_ARGS[@]}"}" -W .github/workflows/ci.yml --container-architecture "$host_arch" -j "$JOB" "${MATRIX_ARGS[@]+"${MATRIX_ARGS[@]}"}" "$@")
printf 'act-cell: host_arch=%s push_devel=%s running: %s\n' "$host_arch" "$PUSH_DEVEL" "${CMD[*]}" >&2

# --------------------------------------------------------------------------
# Watchdog wrapper
# --------------------------------------------------------------------------
# Two-layer protection against stuck `act` runs:
#   1. Stall watchdog: if combined stdout+stderr stops growing for STALL_SECS
#      seconds, SIGTERM the entire process group, then SIGKILL after grace.
#   2. Hard timeout: regardless of activity, after HARD_TIMEOUT_SECS the run
#      is terminated.
#
# --no-watchdog disables the stall layer (hard timeout still enforced via
# `timeout(1)`); intended escape hatch for interactive iteration where the
# operator wants to watch a long-running step without false-firing the stall
# detector.
#
# Implementation notes:
# - The inner command runs under `setsid` so it lives in its own process
#   group. `act` shells out to `docker exec`, which spawns real
#   grandchildren; only `kill -- -PGID` reaches the full subtree.
# - cleanup() is idempotent and runs from BOTH the EXIT trap and explicit
#   INT/TERM traps. This is the belt-and-suspenders that prevents orphan
#   watcher processes from leaking into later cell runs.
if [[ "$NO_WATCHDOG" -eq 1 ]]; then
  # --no-watchdog: hard timeout only. `timeout(1)` sends SIGTERM, then
  # SIGKILL after 10s grace if the child does not exit cleanly.
  exec timeout --kill-after=10s "${HARD_TIMEOUT_SECS}s" "${CMD[@]}"
fi

WATCH_LOG="$(mktemp -t act-cell-watch.XXXXXX)"
WATCH_PID=""
HARD_PID=""
CHILD_PID=""
CLEANUP_DONE=""

cleanup() {
  if [[ -n "${CLEANUP_DONE}" ]]; then return; fi
  CLEANUP_DONE=1
  if [[ -n "${WATCH_PID}" ]]; then
    kill "${WATCH_PID}" 2>/dev/null || true
  fi
  if [[ -n "${HARD_PID}" ]]; then
    kill "${HARD_PID}" 2>/dev/null || true
  fi
  if [[ -n "${CHILD_PID}" ]] && kill -0 "${CHILD_PID}" 2>/dev/null; then
    kill -TERM -- "-${CHILD_PID}" 2>/dev/null || true
    sleep 0.5
    kill -KILL -- "-${CHILD_PID}" 2>/dev/null || true
  fi
  rm -f "${WATCH_LOG}" 2>/dev/null || true
}
trap 'cleanup; exit 130' INT TERM
trap 'cleanup' EXIT

# Enable job control so each background pipeline gets its own process group
# (PGID == leader PID). This is the portable substitute for `setsid` on
# systems (notably macOS) that do not ship util-linux setsid by default.
# `act` shells out to `docker exec`, which spawns real grandchildren; only
# `kill -- -PGID` reaches the full subtree.
set -m

# Launch the child in its own process group. Tee combined stdout+stderr to
# WATCH_LOG so the stall watcher can poll the file's mtime to detect
# inactivity.
bash -c '"$@" 2>&1 | tee "$0"' "${WATCH_LOG}" "${CMD[@]}" &
CHILD_PID=$!

# Stall watcher: poll WATCH_LOG mtime; if no progress for STALL_SECS seconds,
# kill the whole process group. Use a small check interval so the test can
# observe firing quickly with compressed thresholds.
STALL_CHECK_INTERVAL=1
( while kill -0 "${CHILD_PID}" 2>/dev/null; do
    sleep "${STALL_CHECK_INTERVAL}"
    if [[ -e "${WATCH_LOG}" ]]; then
      last_mtime=$(stat -f %m "${WATCH_LOG}" 2>/dev/null || stat -c %Y "${WATCH_LOG}" 2>/dev/null || echo 0)
      now=$(date +%s)
      if [[ $((now - last_mtime)) -ge "${STALL_SECS}" ]]; then
        echo "act-cell: stall watchdog firing after ${STALL_SECS}s of inactivity" >&2
        kill -TERM -- "-${CHILD_PID}" 2>/dev/null || true
        sleep 0.5
        kill -KILL -- "-${CHILD_PID}" 2>/dev/null || true
        exit 0
      fi
    fi
  done ) &
WATCH_PID=$!

# Hard timeout: independent process-group kill. We do NOT use timeout(1) in
# the watchdog form because the child is already wrapped in `setsid bash -c`
# and timeout(1) would only see the wrapper.
( sleep "${HARD_TIMEOUT_SECS}"
  if kill -0 "${CHILD_PID}" 2>/dev/null; then
    echo "act-cell: hard timeout fired after ${HARD_TIMEOUT_SECS}s" >&2
    kill -TERM -- "-${CHILD_PID}" 2>/dev/null || true
    sleep 0.5
    kill -KILL -- "-${CHILD_PID}" 2>/dev/null || true
  fi ) &
HARD_PID=$!

set +e
wait "${CHILD_PID}"
CHILD_RC=$?
set -e
exit "${CHILD_RC}"
