#!/usr/bin/env bash
# act-cell — thin wrapper around `act` for running individual ci.yml cells
# locally. See AGENTS.md §3.6 for context.
#
# Usage: tools/act-cell <cell> [extra act args...]
#   <cell>  cell id from ci.yml (1a, 1b, 1c, 1d, 6, 7, 8, 9, 12, 13, 14) OR
#           job alias (lint, valgrind, helgrind, chronos, nimony). Cells
#           2/3/4/5/18 were retired in push 9 (see audit §3) and now exit 2
#           with a pointer. Cell 1 was split into 1a/1b/1c/1d (per-MM
#           parallel matrix cells); passing bare `1` exits 2 with a pointer.
#
# Cells that cannot run via act locally exit 2 with a clear message:
#   10  Linux arm64 — runs-on: ubuntu-24.04-arm (no amd64 emulation path
#       worth the bother; just push and let GHA's arm64 runner do it).
#   11  macOS arm64 — Docker cannot host a macOS runner.
#   17  Windows MSVC — Docker cannot host a Windows runner.
#   14  nimony — works in principle but pulls ~30 min of build time
#       under qemu emulation; recommended to skip locally.
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: $0 <cell|alias> [extra act args...]" >&2
  echo "  Tier A (always-on):           1a 1b 1c 1d 13 (test-fast); 12 (chronos); 14 (nimony); L (lint)" >&2
  echo "  Tier C (main/devel push gate): 6 7 (test-heavy); 8 (valgrind); 9 (helgrind)" >&2
  echo "  Tier C (no local runner):     10 11 17" >&2
  echo "  aliases: lint valgrind helgrind chronos nimony" >&2
  exit 64
fi

CELL="$1"
shift

# Resolve cell -> (job, matrix-flags). Job names come from ci.yml `jobs:`
# keys; matrix-flags from the `include:` entries in the `test` job. The
# `--matrix cell:<N>` selector pins a single matrix row.
JOB=""
MATRIX_ARGS=()
UNSUPPORTED_REASON=""

case "$CELL" in
  lint|L|l)
    JOB="lint"
    ;;
  valgrind|8)
    JOB="valgrind"
    ;;
  helgrind|9)
    JOB="helgrind"
    ;;
  chronos|12)
    JOB="chronos"
    ;;
  nimony|14)
    UNSUPPORTED_REASON="nimony cell builds nimony from source (~30 min uncached) and runs under amd64 emulation on Apple Silicon (3-5x slowdown). Run on GHA instead."
    ;;
  10)
    UNSUPPORTED_REASON="cell 10 runs on ubuntu-24.04-arm (native arm64 GHA runner); no useful local equivalent under act."
    ;;
  11)
    UNSUPPORTED_REASON="cell 11 is macOS arm64; Docker cannot host a macOS runner. Run natively: nimble test"
    ;;
  17)
    UNSUPPORTED_REASON="cell 17 is Windows MSVC; Docker cannot host a Windows runner. Wait for GHA."
    ;;
  1a|1b|1c|1d|13)
    # Tier A test-fast matrix (cells 1a/1b/1c/1d split baseline by MM
    # variant; cell 13 nim devel informational).
    JOB="test-fast"
    MATRIX_ARGS=(--matrix "cell:$CELL")
    ;;
  1)
    UNSUPPORTED_REASON="cell 1 was split into 1a (orc) / 1b (cpp) / 1c (arc+nebr) / 1d (refc) so MM lanes run as parallel GHA matrix cells. Choose one of 1a/1b/1c/1d."
    ;;
  6|7)
    # Tier C test-heavy matrix (cells 6 TSAN, 7 ASAN; cells 10/11/17 require
    # non-Linux/arm64 runners and are filtered above).
    JOB="test-heavy"
    MATRIX_ARGS=(--matrix "cell:$CELL")
    ;;
  2|3|4|5|18)
    UNSUPPORTED_REASON="cell $CELL was retired in push 9 (audit §3 green-mirage analysis). Cells 2/3/4/5 exported LOCKFREE_MM env var that no source consumed; cell 18 (nim cpp) is covered by cell 1's nimble test inner loop."
    ;;
  *)
    echo "act-cell: unknown cell or alias: $CELL" >&2
    echo "  Tier A: 1a 1b 1c 1d 13 lint chronos nimony 12 14 L" >&2
    echo "  Tier C: 6 7 8 9 valgrind helgrind" >&2
    exit 64
    ;;
esac

if [[ -n "$UNSUPPORTED_REASON" ]]; then
  echo "act-cell: cell '$CELL' cannot run via act locally." >&2
  echo "  reason: $UNSUPPORTED_REASON" >&2
  exit 2
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# Detect container architecture from the host. `.actrc` deliberately
# does not pin one (committed file, shared across arm64/amd64 hosts);
# act otherwise defaults `linux/amd64` regardless of host, which sends
# Apple Silicon down the qemu emulation path (3-5x slowdown). The
# multi-arch ghcr.io/elijahr/lockfree-ci:latest image supports both
# arches natively. If the user passes their own `--container-architecture`
# in "$@", act's last-arg-wins behavior makes their override win.
case "$(uname -m)" in
  arm64|aarch64) host_arch=linux/arm64 ;;
  x86_64|amd64)  host_arch=linux/amd64 ;;
  *) echo "act-cell: warning: unrecognized uname -m=$(uname -m); falling back to linux/amd64" >&2
     host_arch=linux/amd64 ;;
esac

CMD=(act -W .github/workflows/ci.yml --container-architecture "$host_arch" -j "$JOB" "${MATRIX_ARGS[@]}" "$@")
printf 'act-cell: host_arch=%s running: %s\n' "$host_arch" "${CMD[*]}" >&2
exec "${CMD[@]}"
